<Window x:Class="AudioDispatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioDispatcher.UI.ViewModels"
        Title="AudioDispatcher - 多设备音频分发"
        Width="760" Height="620" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 源状态卡 -->
            <RowDefinition Height="Auto"/>   <!-- 引导横幅 -->
            <RowDefinition Height="*"/>      <!-- 设备列表 -->
            <RowDefinition Height="Auto"/>   <!-- 缓冲/延迟设置 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ═══════ ① 源状态卡 ═══════ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="320">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="音频源" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding SourceLine}" Margin="10,0,0,0"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding SourceBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="系统默认输出设为 CABLE Input 后,进入虚拟声卡的声音会在此镜像分发到勾选的设备"
                               FontSize="11" Foreground="#888" Margin="0,3,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="2" Width="260" Margin="0,0,8,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          SelectionChanged="OnSourceSelectionChanged"
                          ToolTip="捕获源端点(VB-Audio 虚拟声卡输出)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="3" Width="110" Padding="0" VerticalAlignment="Center"
                        Content="{Binding RunButtonText}" Click="OnRunButtonClick"
                        FontWeight="SemiBold" Background="#2E7D32" Foreground="White"
                        BorderThickness="0" Height="30"/>
            </Grid>
        </Border>

        <!-- ═══════ 引导横幅(未检测到 VB-Cable) ═══════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVis}}"
                BorderBrush="#F0B429" Background="#FFF9E6">
            <StackPanel>
                <TextBlock Text="未检测到 VB-Audio Cable 虚拟声卡,三步完成设置:"
                           FontWeight="SemiBold" Foreground="#7A5B00"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#6B5A1E">
                    <Run Text="1."/><Run Text=" 从"/>
                    <Hyperlink Click="OnOpenDownloadLink">vb-audio.com/Cable</Hyperlink>
                    <Run Text="下载并安装(免费);"/><LineBreak/>
                    <Run Text="2."/><Run Text=" 系统声音设置 → 输出 中把默认设备选为 CABLE Input (VB-Audio Virtual Cable);"/><LineBreak/>
                    <Run Text="3."/><Run Text=" 回到本窗口勾选要同时出声的设备,点「开始分发」。"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ═══════ ② 目标设备列表 ═══════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10,8,10,6">
                    <TextBlock Text="输出设备(勾选参与同时播放)" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="全部勾选" Padding="8,2" FontSize="11" Click="OnCheckAll" Margin="0,0,6,0"/>
                        <Button Content="全部取消" Padding="8,2" FontSize="11" Click="OnUncheckAll"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="2,0,6,0"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding RowEnabled}"
                                                  Checked="OnRowChecked" Unchecked="OnRowChecked"
                                                  ToolTip="勾选后该设备参与分发"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#222"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                                <Setter Property="Foreground" Value="#AAA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Format}" FontSize="10.5" Foreground="#999"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Minimum="0" Maximum="150" Width="110"
                                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding RowEnabled}"
                                                    ValueChanged="OnRowVolumeChanged"
                                                    ToolTip="音量 0-150%"/>
                                            <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontSize="10"
                                                       Foreground="#777" Margin="4,0,0,0" Width="34"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="3" Content="静音" FontSize="10" Padding="0"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                      IsEnabled="{Binding RowEnabled}"
                                                      Click="OnRowMutedChanged" Height="22"/>

                                        <Button Grid.Column="4" Content="♪" FontSize="12" Padding="0" Height="22"
                                                ToolTip="对本设备播放测试音(200ms)"
                                                IsEnabled="{Binding RowEnabled}"
                                                Click="OnRowTestTone"/>

                                        <ProgressBar Grid.Column="5" Height="8" Margin="6,0" VerticalAlignment="Center"
                                                     Minimum="0" Maximum="1" Value="{Binding Level, Mode=OneWay}"
                                                     Foreground="#2E7D32" Background="#E8EAED"/>

                                        <TextBlock Grid.Column="6" Text="{Binding Stats}" FontSize="10"
                                                   Foreground="#B26A00" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="7" Text="{Binding Error}" FontSize="10.5"
                                                   Foreground="#C62828" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════ ③ 缓冲/延迟设置 ═══════ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="缓冲大小" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="BufferTextBox" Width="56" Text="50" VerticalContentAlignment="Center"
                             KeyDown="OnBufferKeyDown" LostFocus="OnBufferLostFocus"
                             ToolTip="10-500 ms,数值越小延迟越低,过小可能断续"/>
                    <TextBlock Text=" ms (10-500)" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="LatencyHintText" FontSize="11" Foreground="#888"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="BufferStatusText" FontSize="11" Foreground="#B26A00"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════ 状态栏 ═══════ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusLine}" FontSize="11" Foreground="#666" Margin="2,0,0,0"/>
    </Grid>
</Window>
